    {
      "name": "Source row",
      "kind": "card",
      "refersTo": "source-row",
      "html": "<div class=\"ds-source\"><strong>The Pirate Bay</strong><span>1080p · 2.0 GB · 942 seeders</span></div>",
      "css": ".ds-source{padding:20px;background:#213448;color:#e5edf5;border-radius:5px;font-family:\"DM Sans\",sans-serif}.ds-source span{display:block;font-size:14px;margin-top:8px;color:#b7d99c}"
    }
