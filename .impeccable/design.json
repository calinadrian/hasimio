  "narrative": {
    "overview": "User-approved Steam-inspired charcoal navigation, deep-blue surfaces and cyan emphasis with quality-first playback.",
    "keyCharacteristics": [
      "Readable 16px body and poster titles",
      "Native quality dropdown, then compact source selection",
      "Real size, seeders, codec and release-format metadata",
      "Responsive media shelves, calendar and extension rows"
    ],
    "dos": [
      "Retain accessible focus and labeled selects",
      "Offer only available quality tiers",
      "Keep release details accessible"
    ],
    "donts": [
      "Do not invent unavailable resolutions",
      "Do not equate seeders with guaranteed playback",
      "Do not reintroduce the superseded lavender theme"
    ]
  }
