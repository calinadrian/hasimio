      "css": ".ds-primary{font:600 15px \"DM Sans\",sans-serif;min-height:46px;padding:11px 19px;border:1px solid #3e86ac;border-radius:5px;background:linear-gradient(100deg,#236b8e,#245ca3);color:#f3faff}.ds-primary:focus-visible{outline:2px solid #66c0f4;outline-offset:4px}"
