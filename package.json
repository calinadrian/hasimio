{
  "name": "hasimio",
  "productName": "Hasimio",
  "description": "Discover, track and stream movies, series and anime",
  "author": {
    "name": "calinadrian",
    "email": "hassian.inbox@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/calinadrian/hasimio.git"
  },
  "main": "electron/main.mjs",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5176 --strictPort",
    "engine": "node server/engine.mjs",
    "sync:relay": "node server/sync-relay.mjs",
    "package:engine": "node scripts/package-engine.mjs",
    "package:sync": "npm run build && node scripts/package-sync.mjs",
    "icon": "node scripts/make-icon.mjs",
    "desktop": "npm run build && electron .",
    "package:app": "npm run icon && npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:streaming": "node server/smoke.mjs",
    "test:audio": "node server/smoke.mjs --audio",
    "test:audio-sync": "node scripts/audio-sync-smoke.mjs",
    "test:torrentclaw": "node scripts/torrentclaw-smoke.mjs",
    "test:inspections": "node scripts/inspection-smoke.mjs",
    "test:player": "node scripts/player-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "hls.js": "^1.7.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true,
    "node-datachannel@0.32.3": true,
    "utp-native@2.5.3": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "ip-set": false
  }
}
